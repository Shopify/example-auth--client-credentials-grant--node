# Copy this file to .env and fill in your app's credentials, then run from the
# repo root so all three samples find it:
#   node node/index.js       (Node.js 20.12 or later)
#   python python/main.py    (after `pip install requests`)
#   sh curl/example.sh

# Your store's myshopify.com subdomain, without ".myshopify.com"
SHOPIFY_SHOP=your-store

# Your app's credentials from the Dev Dashboard
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
